// Prisma schema for One9Founders
// Based on existing Django models

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  emailVerified DateTime?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  favorites     UserFavorite[]
  reviews       Review[]
  toolUsages    ToolUsage[]
  toolClicks    ToolClick[]
  searchQueries SearchQuery[]
  newsUpvotes   NewsUpvote[]

  @@map("users")
}

// NextAuth Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// Category model
model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tools           Tool[]
  toolSubmissions ToolSubmission[]

  @@map("categories")
}

// Tool model - main entity
model Tool {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  shortDescription String?  @db.VarChar(200)
  description      String   @db.Text

  // URLs
  website      String?
  affiliateUrl String?
  logoUrl      String?
  videoDemoUrl String?

  // Pricing
  pricingModels     Json     @default("[]")
  pricingTiers      Json     @default("[]")
  pricingFrom       Decimal? @db.Decimal(10, 2)
  freeTierAvailable Boolean  @default(false)
  freeTrialDays     Int?
  pricingType       String   @default("freemium")

  // Content
  tags            Json    @default("[]")
  useCases        Json    @default("[]")
  integrations    Json    @default("[]")
  features        Json    @default("[]")
  platforms       Json    @default("[]")
  startupBenefits String? @db.Text
  idealFor        Json    @default("[]")

  // Stats
  rating          Decimal @default(0) @db.Decimal(3, 1)
  reviewCount     Int     @default(0)
  viewsCount      Int     @default(0)
  startupFriendly Boolean @default(false)

  // Status
  verified   Boolean @default(false)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  // AI - Vector embedding for semantic search
  embedding Unsupported("vector(1536)")?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categories      Category[]
  reviews         Review[]
  favorites       UserFavorite[]
  deals           Deal[]
  usages          ToolUsage[]
  clicks          ToolClick[]
  newsArticles    News[]         @relation("NewsRelatedTools")
  toolSubmissions ToolSubmission[]

  @@index([name])
  @@index([rating])
  @@index([isFeatured])
  @@index([isActive])
  @@map("tools")
}

// Review model
model Review {
  id               String   @id @default(cuid())
  toolId           String
  userId           String?
  userName         String?
  userEmail        String?
  rating           Int
  title            String?
  comment          String?  @db.Text
  pros             Json     @default("[]")
  cons             Json     @default("[]")
  verifiedPurchase Boolean  @default(false)
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tool Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolId, createdAt(sort: Desc)])
  @@map("reviews")
}

// User Favorite model
model UserFavorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@map("user_favorites")
}

// Tool Submission model
model ToolSubmission {
  id               String   @id @default(cuid())
  name             String
  description      String   @db.Text
  website          String
  submitterEmail   String
  submitterName    String
  logoUrl          String?
  shortDescription String?  @db.VarChar(200)
  pricingInfo      String?  @db.Text
  enrichedData     Json     @default("{}")
  status           String   @default("pending")
  adminNotes       String?  @db.Text
  approvedToolId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categories   Category[]
  approvedTool Tool?      @relation(fields: [approvedToolId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("tool_submissions")
}

// Newsletter Subscription model
model NewsletterSubscription {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("homepage")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([source])
  @@index([isActive])
  @@map("newsletter_subscriptions")
}

// Deal model
model Deal {
  id                 String    @id @default(cuid())
  toolId             String?
  offerTitle         String    @default("Special Offer")
  oldPrice           Decimal   @default(0) @db.Decimal(10, 2)
  newPrice           Decimal   @default(0) @db.Decimal(10, 2)
  discountPercentage Int       @default(0)
  expiryDate         DateTime?
  claimsCount        Int       @default(0)
  dealUrl            String    @default("#")
  featuredDeal       Boolean   @default(false)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tool Tool? @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@index([expiryDate])
  @@index([featuredDeal])
  @@index([isActive])
  @@map("deals")
}

// Tool Usage tracking
model ToolUsage {
  id        String   @id @default(cuid())
  toolId    String
  userId    String?
  sessionId String?
  ipAddress String?
  createdAt DateTime @default(now())

  tool Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([toolId, createdAt(sort: Desc)])
  @@index([sessionId])
  @@map("tool_usages")
}

// Search Query tracking
model SearchQuery {
  id           String   @id @default(cuid())
  query        String   @db.VarChar(500)
  userId       String?
  sessionId    String?
  ipAddress    String?
  resultsCount Int      @default(0)
  filters      Json     @default("{}")
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([query])
  @@index([sessionId])
  @@index([createdAt(sort: Desc)])
  @@map("search_queries")
}

// Tool Click tracking
model ToolClick {
  id        String   @id @default(cuid())
  toolId    String
  action    String
  userId    String?
  sessionId String?
  ipAddress String?
  referrer  String?
  createdAt DateTime @default(now())

  tool Tool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolId, action, createdAt(sort: Desc)])
  @@index([action])
  @@index([sessionId])
  @@map("tool_clicks")
}

// News/Blog model
model News {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String    @db.VarChar(300)
  content       String    @db.Text
  featuredImage String?
  author        String    @default("Admin")
  category      String?
  tags          Json      @default("[]")
  readingTime   Int       @default(0)
  viewsCount    Int       @default(0)
  upvoteCount   Int       @default(0)
  isPublished   Boolean   @default(false)
  isFeatured    Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  relatedTools Tool[]       @relation("NewsRelatedTools")
  upvotes      NewsUpvote[]

  @@index([category])
  @@index([isPublished])
  @@map("news")
}

// News Upvote model
model NewsUpvote {
  id        String   @id @default(cuid())
  newsId    String
  userId    String?
  sessionId String?
  ipAddress String?
  createdAt DateTime @default(now())

  news News  @relation(fields: [newsId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([newsId, userId])
  @@unique([newsId, sessionId])
  @@map("news_upvotes")
}
